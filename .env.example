# copy to .env, which is gitignored
ANTHROPIC_API_KEY=

# step 20 compares these two. keep both pinned. unpinned means I can't attribute
# any eval row to anything, and retrofitting cost data means re-running the backfill.
CHEAP_MODEL=claude-haiku-4-5
STRONG_MODEL=claude-opus-5

# ingest is monthly and offline, so it goes through the Batch API at 50% off.
# flip to false only when iterating on a prompt and I want the answer now.
USE_BATCH_API=true

# LLM ladder: required prices for the exact STRONG_MODEL above, in USD / 1M tokens.
# Copy current standard synchronous API rates from your provider's pricing page.
# These are intentionally blank: the runner does not guess or fetch model prices.
# The ladder is synchronous (ignores USE_BATCH_API) and does not enable prompt caching.
LLM_INPUT_USD_PER_MTOK=
LLM_OUTPUT_USD_PER_MTOK=
LLM_CACHE_READ_USD_PER_MTOK=
LLM_CACHE_WRITE_USD_PER_MTOK=
LLM_PRICE_SOURCE=https://platform.claude.com/docs/en/about-claude/pricing
